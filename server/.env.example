# Copy this file to .env and fill in real values. Never commit the real .env.

# Required: your real Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=

# Optional but recommended once this is deployed anywhere public: a random
# string the desktop app must also send (as the x-app-secret header) for the
# server to respond. Generate one with: openssl rand -hex 32
# Leave blank for local dev if you want auth disabled.
APP_SHARED_SECRET=

# Optional: port to listen on, defaults to 8787
PORT=8787

# Required for accounts (sign up / log in / password reset): connection
# string for a Postgres database, where user accounts and their `tier` live
# (this is separate from the clipboard history, which is local SQLite on
# each user's own machine and never touches this server). Free managed
# Postgres: neon.tech, supabase.com, or Railway's own Postgres add-on. Looks
# like: postgres://user:password@host/dbname
# Without this, all /auth/* routes return an error.
DATABASE_URL=

# Required for accounts (sign up / log in): secret used to sign session
# tokens. Generate one with: openssl rand -hex 32
# Without this, /auth/signup and /auth/login return an error.
JWT_SECRET=

# Optional: sends a welcome email on sign-up (see email.js). Get a free key
# at resend.com -- without this set, the welcome email is just skipped, sign-up
# still works fine.
RESEND_API_KEY=

# Optional: who welcome emails appear to be from. Defaults to Resend's own
# onboarding@resend.dev test sender, which works instantly but can only send
# to the email address you signed up to Resend with. Once you've added and
# verified your own domain in the Resend dashboard, set this to something
# like: Clip <hello@yourdomain.com>
EMAIL_FROM=

# Required for semantic search (Pro-only /embed endpoint): an API key from
# voyageai.com. Free tier is 200 million tokens, which is a lot of headroom
# for clipboard-sized text. Without this set, /embed returns an error and
# semantic search just silently contributes nothing -- substring search in
# the app keeps working either way.
VOYAGE_API_KEY=

# --- Billing (Stripe) -- see docs/billing-flow.md -------------------------

# Required for billing: your Stripe secret key (test mode: starts sk_test_,
# live mode: sk_live_), from dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=

# Required for billing: the signing secret for your webhook endpoint, from
# dashboard.stripe.com/webhooks (after creating the endpoint) -- or from
# `stripe listen` if testing locally with the Stripe CLI. Without this,
# /billing/webhook rejects every event (signature verification fails closed,
# not open).
STRIPE_WEBHOOK_SECRET=

# Required for billing: the two recurring Price ids from your "Clip Pro"
# product in the Stripe dashboard (Products -> Clip Pro -> each price's
# "..." menu -> copy ID). Looks like price_1AbCdEfGhIjKlMnOp.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Required for billing: where Stripe Checkout/the Billing Portal redirect
# the browser back to when someone's done -- needs website/checkout-success.html
# and website/checkout-cancel.html to be reachable at this URL. No trailing
# slash. E.g. https://fatclipboard.com once the website is deployed
# somewhere; for local testing with the Stripe CLI, something like
# http://localhost:5500 (any static file server pointed at website/) works.
WEBSITE_URL=
