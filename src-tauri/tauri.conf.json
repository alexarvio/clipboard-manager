{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FatClipboard",
  "version": "0.2.2",
  "identifier": "com.alex.clip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FatClipboard",
        "width": 576,
        "height": 672,
        "x": 0,
        "y": 0,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": false,
        "shadow": false
      },
      {
        "label": "dashboard",
        "title": "FatClipboard Dashboard",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENTJDMTg5QTQxNTNGMkYKUldRdlB4V2tpY0ZTTFpFU05PVHVmTkUvWTdSa25nZE5nY1NqSkF1SVRrYTkrQ1lvUUVUQjNnQjIK",
      "endpoints": [
        "https://github.com/alexarvio/clipboard-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
